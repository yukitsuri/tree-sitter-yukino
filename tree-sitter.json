{
  "grammars": [
    {
      "name": "yukino",
      "camelcase": "Yukino",
      "scope": "source.yukino",
      "file-types": ["ykn"],
      "injection-regex": "^(yukino|ykn)$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Clean Tree-sitter parser for the Yukino programming language",
    "authors": [
      {
        "name": "Yukitsuri"
      }
    ],
    "links": {
      "repository": "https://github.com/yukitsuri/tree-sitter-yukino"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
